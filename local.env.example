# Copy to `local.env` (git-ignored) and set what differs on your machine; every line is optional.
# Format: NAME ?= value (no quotes; spaces in paths are fine). An environment variable or `make NAME=...` wins.
# Read by the Makefile and by the scripts in tools/ (tools/local_env.sh). In a git worktree, the main checkout's
# local.env is used when the worktree has none. docs/BUILDING.md explains each.

# The decomp: a snapshot of a committed decomp revision (only needed to regenerate gen/ or for its optional checks;
# without it the build uses the committed generated code). Default: ../decomp-snap/boot2w or ../burnout3-retail-decomp
#DECOMP ?= /path/to/decomp-snap/boot2w
#DECOMP_LIVE ?= /path/to/burnout3-retail-decomp

# SDL3 on Linux: an unpacked prefix (contains include/SDL3 and lib/x86_64-linux-gnu). Default: the system's SDL3 via
# pkg-config (libsdl3-dev / SDL3-devel), else ../ext/sdl3-3.4.2/usr
#SDL3_PREFIX ?= /path/to/sdl3-3.4.2/usr

# Your Burnout 3 (NTSC-U, SLUS-21050) disc files, for the optional real-data tests. Default: data/game in the repo
#GAME ?= /path/to/disc-folder

# A memory card folder with a profile (e.g. a 100 % save), for race_check.sh and the save tests. Default: none (skipped)
#SAVES ?= /path/to/saves-100

# Windows builds from WSL (tools/native/build_win.sh, tools/render/build_win.sh, tools/release/package_win.sh): a folder
# on the Windows side holding toolchain/mingw64 (the verified MSYS2 MinGW toolchain, tools/toolchain/toolchain.sha256);
# outputs go there too. Default: build-win in the repo
#WIN ?= /mnt/c/Users/you/b3-port-win
# (the docs write this folder as $B3_WIN in WSL commands and %B3_WIN% in Windows ones)
# The MSYS2 SDL3 package, unpacked, and the folder with its .pkg.tar.zst (hash checked). Default: ../ext/...
#SDL3_MINGW ?= /path/to/sdl3-3.4.2-mingw64/mingw64
#MSYS2_PKGS ?= /path/to/msys2-pkgs
